[Unit]
Description=DLC 백엔드 API (Express)
# 네 저장소가 모두 떠 있어야 기동 직후 요청을 받을 수 있다. PostgreSQL 은
# source of truth 라 필수, 나머지 셋은 없어도 앱은 뜨지만 검색·RDF·XML 이 죽는다.
After=network-online.target postgresql.service dl-elasticsearch.service dl-fuseki.service dl-basex.service
Wants=network-online.target dl-elasticsearch.service dl-fuseki.service dl-basex.service
Requires=postgresql.service

[Service]
Type=exec
User=user
Group=user
WorkingDirectory=__ROOT__/backend
EnvironmentFile=__ROOT__/backend/.env
Environment=NODE_ENV=production
Environment=PATH=__ROOT__/.runtime/node/bin:/usr/local/bin:/usr/bin:/bin
# 127.0.0.1 에만 묶인다(src/server.js). 바깥에서는 Caddy 를 거쳐야만 닿는다.
ExecStart=__ROOT__/.runtime/node/bin/node src/server.js

TimeoutStartSec=120
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# OAI 수확기가 tools/harvest-state.json 에 마지막 수확일을 적는다.
ReadWritePaths=__ROOT__/tools
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
