[Unit]
Description=DLC Apache Jena Fuseki (RDF 트리플스토어)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=user
Group=user
# fuseki-server.jar 는 자기 옆의 webapp/ 를 찾는다. 다른 곳에서 실행하면
# "Can't find resourceBase" 로 뜨지 못한다.
WorkingDirectory=/opt/dl/fuseki
Environment=FUSEKI_BASE=/opt/dl/fuseki/base
# --update    가 있어야 pg-to-fuseki.js 가 SPARQL Update 로 적재할 수 있다.
#             (FUSEKI_DATASET 환경변수로 만들면 read-only 가 되므로 쓰지 않는다)
# --localhost 는 127.0.0.1 에만 묶는다. 이 머신은 공인 IP 를 직접 물고 있어서
#             기본값(0.0.0.0)으로 두면 인증 없는 SPARQL Update 엔드포인트가
#             그대로 바깥에 열린다. 조회는 백엔드의 /api/v1/sparql 을 거친다.
ExecStart=/usr/bin/java -Xmx1g -jar /opt/dl/fuseki/fuseki-server.jar \
	--tdb2 --update --localhost \
	--loc=/opt/dl/fuseki/databases/digital-library /digital-library

TimeoutStartSec=120
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/dl/fuseki
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
