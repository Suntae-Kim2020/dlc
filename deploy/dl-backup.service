[Unit]
Description=DLC 데이터베이스 백업
# 백업 디스크가 붙어 있어야 의미가 있다.
RequiresMountsFor=__BACKUP_MOUNT__

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_USER__
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=DL_BACKUP_DEST=__BACKUP_DEST__
ExecStart=__ROOT__/deploy/backup.sh --verify
# 실패하면 journal 에 남는다:  journalctl -u dl-backup
