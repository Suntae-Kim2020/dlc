[Unit]
Description=DLC 데이터베이스 백업
# 백업 디스크가 붙어 있어야 의미가 있다.
RequiresMountsFor=/media/user/df9db4f3-386b-4bd4-b1bf-fcebb530b180

[Service]
Type=oneshot
User=user
Group=user
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=__ROOT__/deploy/backup.sh --verify
# 실패하면 journal 에 남는다:  journalctl -u dl-backup
