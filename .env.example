# ===========================================
# 디지털도서관 시스템 환경변수
# ===========================================

# 데이터베이스 (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_library
DB_USER=dluser
DB_PASSWORD=your_password_here

# Elasticsearch
ES_HOST=localhost
ES_PORT=9200

# Apache Jena Fuseki
FUSEKI_HOST=localhost
FUSEKI_PORT=3030
FUSEKI_DATASET=digital-library

# API 서버
API_PORT=4000
JWT_SECRET=your_jwt_secret_here

# Claude API (RAG 검색용)
CLAUDE_API_KEY=your_api_key_here

# 운영(데모) 환경 — 검색 전용 모드
# 'true'로 설정하면 모든 쓰기 요청(POST/PUT/DELETE)과 RAG가 차단됨.
# 로컬 개발 환경에선 비워두거나 false로 설정.
READ_ONLY_MODE=false

# CORS 허용 origin (운영 시 https://dl.ailibrary.kr 등으로 설정)
ALLOWED_ORIGIN=http://localhost:3000
