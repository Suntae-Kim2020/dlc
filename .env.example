# ===========================================
# 디지털도서관 시스템 환경변수
# ===========================================

# 데이터베이스 (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_library
DB_USER=dluser
DB_PASSWORD=your_password_here

# Elasticsearch
ES_HOST=localhost
ES_PORT=9200

# Apache Jena Fuseki
FUSEKI_HOST=localhost
FUSEKI_PORT=3030
FUSEKI_DATASET=digital-library

# API 서버
API_PORT=4000
JWT_SECRET=your_jwt_secret_here

# Claude API (RAG 검색용)
CLAUDE_API_KEY=your_api_key_here

# 운영(데모) 환경 — 검색 전용 모드
# 'true'로 설정하면 모든 쓰기 요청(POST/PUT/DELETE)이 차단됨.
# RAG는 별도로 RAG_PASSWORD로 통제 (아래 참고).
READ_ONLY_MODE=false

# RAG 비밀번호 — 설정 시 X-RAG-Password 헤더로 인증해야 RAG 사용 가능
# 미설정(또는 빈 값)이면 인증 없이 사용 가능 (개발 환경)
RAG_PASSWORD=

# CORS 허용 origin (운영 시 https://dl.ailibrary.kr 등으로 설정)
ALLOWED_ORIGIN=http://localhost:3000

# ---- 배포 서버 (tools/migrate-to-server.js — 로컬 dev 데이터를 서버로 보낼 때) ----
# 실제 값은 .env 에만 기재 (gitignore 대상). 코드에 기본값 없음.
SERVER_HOST=
SERVER_USER=
# SSH 개인키 경로 (미지정 시 ~/.ssh/id_rsa)
SERVER_KEY=
# 서버의 저장소 경로 (미지정 시 /home/user/DLC/digital-library)
SERVER_PATH=
# SSH 포트 (미지정 시 22 — 운영 서버는 22 가 아니다)
SERVER_PORT=
